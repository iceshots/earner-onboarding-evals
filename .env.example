# Copy this file to .env (which is gitignored) and fill in your key.
ANTHROPIC_API_KEY=
# Bot model: Haiku for now (see "Model choice" in README.md). Sonnet is the later comparison and the judge.
BOT_MODEL=claude-haiku-5-5
# Optional: thinking depth (low | medium | high). Default medium.
# BOT_EFFORT=medium
# Optional: which bot/config/<version>/ folder to load. Default v1.
# BOT_CONFIG_VERSION=v1
# Optional: questions allowed per browser session in the Streamlit app. Default 10.
# BOT_MAX_QUESTIONS_PER_SESSION=10
